[gd_scene load_steps=11 format=3]

[ext_resource type="Script" path="res://scripts/vehicle/vehicle_controller.gd" id="1_ctrl"]
[ext_resource type="Script" path="res://scripts/vehicle/wheel_mount.gd" id="2_wheel"]
[ext_resource type="Resource" path="res://tuning/handling.tres" id="3_handling"]
[ext_resource type="PackedScene" path="res://assets/authored/vehicles/taxi_body.glb" id="4_body"]
[ext_resource type="PackedScene" path="res://assets/authored/vehicles/taxi_tyre.glb" id="5_wheelmesh"]
[ext_resource type="Script" path="res://scripts/vehicle/wheel_visual.gd" id="6_wheelvis"]
[ext_resource type="Script" path="res://scripts/vehicle/sun_glint.gd" id="7_glint"]
[ext_resource type="Material" path="res://tuning/vehicle_body.tres" id="8_bodymat"]
[ext_resource type="Script" path="res://scripts/vehicle/vehicle_lamps.gd" id="9_lamps"]

; Not the visual body, deliberately — see docs/PROGRESS.md, P3-11. Godot strips
; these comments on any editor resave, so the reasoning lives there, not here.
[sub_resource type="BoxShape3D" id="BoxShape3D_body"]
size = Vector3(1.8, 0.7, 4.0)

[node name="Taxi" type="RigidBody3D"]
mass = 1200.0
script = ExtResource("1_ctrl")
profile = ExtResource("3_handling")

[node name="Body" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.35, 0)
shape = SubResource("BoxShape3D_body")

; The lamp rig rides on the body mesh rather than beside it, the same way
; `WheelVisual` rides on the tyre: the circuits are per-instance shader state,
; and the instance is the `MeshInstance3D` inside this .glb. See
; scripts/vehicle/vehicle_lamps.gd. Godot strips these comments on any editor
; resave, so the reasoning lives in the script, not here.
[node name="Mesh" parent="." instance=ExtResource("4_body")]
script = ExtResource("9_lamps")

; Feeds the body shader the scene's real sun, so the glint never carries a
; second copy of the rig's rotation. See scripts/vehicle/sun_glint.gd.
[node name="SunGlint" type="Node3D" parent="."]
script = ExtResource("7_glint")
material = ExtResource("8_bodymat")

[node name="WheelFL" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.8, 0, -1.3)
script = ExtResource("2_wheel")
steers = true

[node name="Visual" parent="WheelFL" instance=ExtResource("5_wheelmesh")]
script = ExtResource("6_wheelvis")

[node name="WheelFR" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.8, 0, -1.3)
script = ExtResource("2_wheel")
steers = true

[node name="Visual" parent="WheelFR" instance=ExtResource("5_wheelmesh")]
script = ExtResource("6_wheelvis")

[node name="WheelRL" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.8, 0, 1.3)
script = ExtResource("2_wheel")
drives = true

[node name="Visual" parent="WheelRL" instance=ExtResource("5_wheelmesh")]
script = ExtResource("6_wheelvis")

[node name="WheelRR" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.8, 0, 1.3)
script = ExtResource("2_wheel")
drives = true

[node name="Visual" parent="WheelRR" instance=ExtResource("5_wheelmesh")]
script = ExtResource("6_wheelvis")
