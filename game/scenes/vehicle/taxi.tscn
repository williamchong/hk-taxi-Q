[gd_scene load_steps=11 format=3]

[ext_resource type="Script" path="res://scripts/vehicle/vehicle_controller.gd" id="1_ctrl"]
[ext_resource type="Script" path="res://scripts/vehicle/wheel_mount.gd" id="2_wheel"]
[ext_resource type="Resource" path="res://tuning/handling.tres" id="3_handling"]
[ext_resource type="PackedScene" path="res://assets/authored/vehicles/taxi_body.glb" id="4_body"]
[ext_resource type="PackedScene" path="res://assets/authored/vehicles/taxi_tyre.glb" id="5_wheelmesh"]
[ext_resource type="Script" path="res://scripts/vehicle/wheel_visual.gd" id="6_wheelvis"]
[ext_resource type="Script" path="res://scripts/vehicle/sun_glint.gd" id="7_glint"]
[ext_resource type="Material" path="res://tuning/vehicle_body.tres" id="8_bodymat"]
[ext_resource type="Script" path="res://scripts/vehicle/vehicle_lamps.gd" id="9_lamps"]

; Not the visual body, deliberately — see docs/PROGRESS.md, P3-11. Godot strips
; these comments on any editor resave, so the reasoning lives there, not here.
[sub_resource type="BoxShape3D" id="BoxShape3D_body"]
size = Vector3(1.8, 0.7, 4.0)

[node name="Taxi" type="RigidBody3D"]
mass = 1200.0
script = ExtResource("1_ctrl")
profile = ExtResource("3_handling")

[node name="Body" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.35, 0)
shape = SubResource("BoxShape3D_body")

; The lamp rig rides on the body mesh rather than beside it, the same way
; `WheelVisual` rides on the tyre: the circuits are per-instance shader state,
; and the instance is the `MeshInstance3D` inside this .glb. See
; scripts/vehicle/vehicle_lamps.gd. Godot strips these comments on any editor
; resave, so the reasoning lives in the script, not here.
[node name="Mesh" parent="." instance=ExtResource("4_body")]
script = ExtResource("9_lamps")

; The light the headlamps actually throw, switched by vehicle_lamps.gd along
; with the lenses — the lenses only glow, and a glowing lamp over a black road
; is what P3-11e shipped first.
;
; One cone per lamp, at the same x as the lenses tools/make_vehicle.py builds
; (+/-0.58). A single central spot shipped first and was rejected on the look:
; the argument for it was that two cones merge into one pool a few metres out,
; which is true of the far field and misses the near field entirely — the twin
; roots at the bumper are the part that reads as a car rather than as a torch.
; The script drives however many spots the scene holds, so this is a scene edit.
;
; Rotated 7 degrees down, so the pool lands down the road rather than at the
; bumper. Basis is row-major here: the *column* -Z each shines along works out as
; (0, -0.122, -0.993) — forward and slightly down.
;
; spot_angle is Godot's HALF angle, which is the trap in this node. 34 here is a
; 68-degree floodlight, and from a lamp 0.3 m off the ground most of that cone
; points at the sky while the rest lands under the nose — the first version did
; exactly that and read as a puddle round the car.
;
; 11 is set by how far the two pools stay apart, not by what a headlamp spreads.
; Lamps 0.58 m off centre overlap from d = 0.58/tan(angle) onward, so 22 merged
; them into one pool inside 1.5 m and rendered as a single blob with two lamps
; behind it; 15 still read as one lobe with a notch. 11 holds them apart to
; ~3 m, which is where the chase camera sits, so the twin cones are legible in
; the view the player actually has.
;
; light_energy is per lamp and lower than the single spot's 7.0, because two
; overlapping cones add where they cross and the centre of the road is exactly
; where they do. spot_attenuation is below Godot's 1.0 default on purpose: the
; default falls off fast enough that the pool dies within a few metres of a 55 m
; light, so the range dial reads as doing nothing. shadow_enabled stays off, and
; that is the mobile tier's rule rather than a saving: docs/ART_DESIGN.md allows
; vehicle blob shadows and no realtime shadow maps. light_energy and spot_range
; are written by the script from beam_energy and sidelamp_beam; the values here
; are what a main beam is authored at. Godot strips these comments on any editor
; resave, so the reasoning lives in the script, not here.
[node name="HeadlampL" type="SpotLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.99255, 0.12187, 0, -0.12187, 0.99255, -0.58, 0.5, -2.05)
visible = false
light_color = Color(1, 0.97, 0.91, 1)
light_energy = 4.5
shadow_enabled = false
spot_range = 55.0
spot_angle = 11.0
spot_attenuation = 0.45

[node name="HeadlampR" type="SpotLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.99255, 0.12187, 0, -0.12187, 0.99255, 0.58, 0.5, -2.05)
visible = false
light_color = Color(1, 0.97, 0.91, 1)
light_energy = 4.5
shadow_enabled = false
spot_range = 55.0
spot_angle = 11.0
spot_attenuation = 0.45

; Feeds the body shader the scene's real sun, so the glint never carries a
; second copy of the rig's rotation. See scripts/vehicle/sun_glint.gd.
[node name="SunGlint" type="Node3D" parent="."]
script = ExtResource("7_glint")
material = ExtResource("8_bodymat")

