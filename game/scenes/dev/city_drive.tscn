[gd_scene load_steps=9 format=3]

; The first scene that puts the car on the real city (`P1-4` + `P0-5`).
;
; `city_preview.tscn` is for looking at the ETL output; this is for driving it.
; The two are separate because they answer different questions and want
; different cameras — and because a free-look camera in a scene with a physics
; body is a scene where nobody is sure what they just judged.
;
; It exists to put a real answer under `Q8` — whether real Wan Chai geometry is
; fun to drive — which a grey box could not.
;
; Since `P2-1` the tiles stream from `city.json` rather than being instantiated
; wholesale by a dev preview, so this is no longer only a dev scene: it is what
; `run/main_scene` boots and the closest thing to a build the project has. The
; buildings still carry no collision — that is an ETL product, see PROGRESS.md.

[ext_resource type="Script" path="res://scripts/city/city_streamer.gd" id="1_tiles"]
[ext_resource type="Resource" path="res://tuning/streaming.tres" id="8_streaming"]
[ext_resource type="Script" path="res://scripts/city/road_surface_preview.gd" id="2_surface"]
[ext_resource type="PackedScene" path="res://scenes/world/golden_hour.tscn" id="3_light"]
[ext_resource type="PackedScene" path="res://scenes/vehicle/taxi.tscn" id="4_taxi"]
[ext_resource type="Script" path="res://scripts/camera/chase_camera.gd" id="5_camera"]
[ext_resource type="Script" path="res://scripts/city/drive_harness.gd" id="6_harness"]
[ext_resource type="Script" path="res://scripts/city/road_graph_overlay.gd" id="7_graph"]

[node name="CityDrive" type="Node3D"]
script = ExtResource("6_harness")
vehicle_path = NodePath("Taxi")

; `camera_path` points at the Camera3D inside the rig, not at the rig and not
; at the Taxi — the far plane is on the camera, and it is the camera a look-back
; swings away from the car. See city_streamer.gd for the rest.
[node name="Tiles" type="Node3D" parent="."]
script = ExtResource("1_tiles")
profile = ExtResource("8_streaming")
camera_path = NodePath("../CameraRig/Camera3D")

[node name="RoadSurface" type="Node3D" parent="."]
script = ExtResource("2_surface")

[node name="GoldenHour" parent="." instance=ExtResource("3_light")]

; Eastbound in the nearside lane of Expo Drive, underneath HKCEC Phase II.
;
; Derived, not eyeballed, and from a published fact rather than from taste: it is
; fare node f_004, "Expo Drive eastbound underneath HKCEC Phase II", a real taxi
; stand in the Transport Department's data. The car starts where a Hong Kong taxi
; would be waiting. Reproduce it from fares.json alone — f_004 publishes
; nearest_edge 651 and edge_t 0.598491, so no projection is needed — by walking
; that polyline in plan to edge_t and offsetting 2.56 m into the nearside lane.
;
; Y is road surface + 1.0 m. That is a drop height, not a measurement: the wheel
; ray is 0.70 m, so the car starts 0.30 m clear and settles onto its suspension.
; drive_harness.gd derives its fall floor from this, so moving the spawn moves
; the floor.
;
; See docs/ARCHITECTURE.md "To drive it" for why the car must not start on the
; centreline, and for the row-major trap in this literal — a transposed basis is
; a silent no-op on a north-south street.
[node name="Taxi" parent="." instance=ExtResource("4_taxi")]
transform = Transform3D(0.0704, 0, -0.9975, 0, 1, 0, 0.9975, 0, 0.0704, 172.3485, 6.5796, 26.9396)

; `P2-2`'s debug overlay: what `RoadGraph` believes is under the car, drawn on
; the road and written out as text. Dev-only, and after the Taxi so the node it
; follows already exists when it looks for it.
[node name="GraphOverlay" type="Node3D" parent="."]
script = ExtResource("7_graph")
vehicle_path = NodePath("../Taxi")

[node name="CameraRig" type="SpringArm3D" parent="."]
margin = 0.3
script = ExtResource("5_camera")
target_path = NodePath("../Taxi")
camera_path = NodePath("Camera3D")

; 400 m, not the fly camera's 2 km. The region is only 1.66 km across, so a 2 km
; far plane culls nothing at all, and a chase camera 6.5 m behind a car in a Wan
; Chai street canyon cannot see past a couple of blocks anyway. Measured: 94 draw
; calls and 2.06 M primitives at 2 km, against 48 and 1.16 M at 400 m, with
; nothing visible lost at street level.
[node name="Camera3D" type="Camera3D" parent="CameraRig"]
far = 400.0
