[gd_scene load_steps=17 format=3]

; The first scene that puts the car on the real city (`P1-4` + `P0-5`).
;
; `city_preview.tscn` is for looking at the ETL output; this is for driving it.
; The two are separate because they answer different questions and want
; different cameras — and because a free-look camera in a scene with a physics
; body is a scene where nobody is sure what they just judged.
;
; It exists to put a real answer under `Q8` — whether real Wan Chai geometry is
; fun to drive — which a grey box could not.
;
; Since `P2-1` the tiles stream from `city.json` rather than being instantiated
; wholesale by a dev preview, so this is no longer only a dev scene: it is what
; `run/main_scene` boots and the closest thing to a build the project has. The
; buildings still carry no collision — that is an ETL product, see PROGRESS.md.

[ext_resource type="Script" path="res://scripts/city/city_streamer.gd" id="1_tiles"]
[ext_resource type="Resource" path="res://tuning/streaming.tres" id="8_streaming"]
[ext_resource type="Script" path="res://scripts/city/road_surface_preview.gd" id="2_surface"]
[ext_resource type="Script" path="res://scripts/city/tramway_preview.gd" id="10_tramway"]
[ext_resource type="Script" path="res://scripts/city/arrows_preview.gd" id="11_arrows"]
[ext_resource type="Script" path="res://scripts/city/boxjunctions_preview.gd" id="12_boxjunctions"]
[ext_resource type="Script" path="res://scripts/city/railings_preview.gd" id="13_railings"]
[ext_resource type="Script" path="res://scripts/city/signs_preview.gd" id="14_signs"]
[ext_resource type="Script" path="res://scripts/city/roadmarks_preview.gd" id="15_roadmarks"]
[ext_resource type="Script" path="res://scripts/city/signals_preview.gd" id="16_signals"]
[ext_resource type="PackedScene" path="res://scenes/world/clean_daylight.tscn" id="3_light"]
[ext_resource type="PackedScene" path="res://scenes/vehicle/taxi.tscn" id="4_taxi"]
[ext_resource type="Script" path="res://scripts/camera/chase_camera.gd" id="5_camera"]
[ext_resource type="Script" path="res://scripts/city/drive_harness.gd" id="6_harness"]
[ext_resource type="Script" path="res://scripts/city/road_graph_overlay.gd" id="7_graph"]
