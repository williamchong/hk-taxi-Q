[ext_resource type="Script" path="res://scripts/city/landmarks.gd" id="7_landmarks"]
[ext_resource type="Script" path="res://scripts/camera/free_look_camera.gd" id="2_camera"]
[ext_resource type="PackedScene" path="res://scenes/world/clean_daylight.tscn" id="3_light"]
[ext_resource type="Script" path="res://scripts/city/road_preview.gd" id="4_roads"]
[ext_resource type="Script" path="res://scripts/city/road_surface_preview.gd" id="5_surface"]
