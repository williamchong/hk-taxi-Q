[node name="RoadSurface" type="Node3D" parent="."]
script = ExtResource("5_surface")

; The tramway (`P3-14`). Here as well as in `city_drive.tscn` because the two
; fixed colour viewpoints `Q27` judges the palette from are shot in this scene,
; and the rail is the brightest thing the city puts on a road surface — a look
; change judged without it would be judged on a city that is missing its
; highest-contrast element.
[node name="Tramway" type="Node3D" parent="."]
script = ExtResource("11_tramway")

; The turn arrows (`P3-15`), here as well as in `city_drive.tscn` for the same
; reason the tramway is. Separate from the ribbon because drawing them on it
; would put them under `road_markings.tres`'s 6 m junction fade at exactly the
; junctions they are about; a region whose sources publish no marking symbols
; ships none and this node simply stays empty.
[node name="Arrows" type="Node3D" parent="."]
script = ExtResource("12_arrows")

; The published yellow box junctions (`P3-18`), one mesh for the whole region.
; A region whose sources publish no box polygons ships none and this node
; simply stays empty.
[node name="BoxJunctions" type="Node3D" parent="."]
script = ExtResource("13_boxjunctions")

; The published stop and give-way lines (`P3-23`), one mesh for the whole
; region, drawn across the junction mouths rather than along the road, and
; hosted by the road each one *crosses* — the two disagree on 43% of the
; layer. A region whose sources publish no transverse markings ships none and
; this node simply stays empty.
[node name="RoadMarks" type="Node3D" parent="."]
script = ExtResource("16_roadmarks")

; The published traffic signal heads (`P3-17`), one mesh for the whole region,
; standing on the kerb the ribbon actually drew rather than where they were
; surveyed — nearly three quarters of them were surveyed inside it. Static and
; **unlit**: no dataset publishes signal timing, an invented cycle instructs, and
; nothing obeys it until `P3-3`'s traffic exists. A region whose publisher spells
; its codes outside `head_prefixes` ships none and this node simply stays empty.
[node name="Signals" type="Node3D" parent="."]
script = ExtResource("17_signals")

; The published pedestrian railings (`P3-19`), one mesh for the whole
; region, standing on the kerb the ribbon actually drew rather than where
; they were surveyed — two-thirds of them were surveyed inside it. A region
; whose sources publish no railing layer ships none and this node simply
; stays empty.
[node name="Railings" type="Node3D" parent="."]
script = ExtResource("14_railings")

; The published traffic signs (`P3-16`), one mesh for the whole region, standing
; on the poles TD surveyed rather than at the abbreviation points that name them
; — those are drawing labels and sit a median 2.6 m away. Only the signs whose
; meaning is their *shape* are here; the text-faced 2,364 are refused (`Q42`).
[node name="Signs" type="Node3D" parent="."]
script = ExtResource("15_signs")

; The authored heroes (`P3-6`). Without them this scene shows holes where the
; excluded source buildings stood — and the audit viewpoints below are the
; frames the heroes exist to be judged in.
[node name="Landmarks" type="Node3D" parent="."]
script = ExtResource("7_landmarks")

; `P1-5`'s fare nodes. Visible by default, unlike the graph diagnostic below,
; because nothing else in this scene draws them and they do not z-fight anything
; — the pins sit in the air and the tethers are lifted clear of the carriageway.
[node name="Fares" type="Node3D" parent="."]
script = ExtResource("6_fares")

; The `P1-3` graph diagnostic, kept and hidden. It draws flat ribbons at the
; same heights the surface now occupies, so leaving both on z-fights; switch it
; back on to read one-way arrows or elevation levels off the graph itself.
[node name="Roads" type="Node3D" parent="."]
visible = false
script = ExtResource("4_roads")

