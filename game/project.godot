; Engine configuration file.
;
; WARNING: Godot rewrites this file from scratch whenever Project Settings is
; saved in the editor, discarding every comment below. The durable record of
; why these values were chosen is docs/ARCHITECTURE.md "Project settings".

config_version=5

[application]

config/name="hk-taxi-Q"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
; Uncapped rendering on a 90/120 Hz phone panel buys nothing above the 60fps
; target and throttles the device. Desktop stays uncapped.
run/max_fps.mobile=60

[autoload]

DebugHud="*res://scripts/ui/debug_hud.gd"
FpsCounter="*res://scripts/ui/fps_counter.gd"
InputRouter="*res://scripts/input/input_router.gd"
BeamBudget="*res://scripts/vehicle/beam_budget.gd"

[debug]

; GDScript warnings promoted to errors. Godot still exits 0 on every one of
; them, so tools/check.sh greps the output — running --import by hand proves
; nothing. Level 1 is invisible headlessly, only 2 surfaces, so entries here
; are all 2. Rationale and the omitted warnings: docs/ARCHITECTURE.md
; "GDScript warnings".
gdscript/warnings/unused_variable=2
gdscript/warnings/unused_local_constant=2
gdscript/warnings/unused_private_class_variable=2
gdscript/warnings/unused_parameter=2
gdscript/warnings/unused_signal=2
gdscript/warnings/shadowed_variable=2
gdscript/warnings/shadowed_variable_base_class=2
gdscript/warnings/standalone_expression=2
gdscript/warnings/standalone_ternary=2
gdscript/warnings/incompatible_ternary=2
gdscript/warnings/untyped_declaration=2
gdscript/warnings/redundant_await=2
gdscript/warnings/integer_division=2
gdscript/warnings/narrowing_conversion=2
gdscript/warnings/int_as_enum_without_cast=2
gdscript/warnings/int_as_enum_without_match=2
gdscript/warnings/confusable_identifier=2
gdscript/warnings/confusable_local_declaration=2
gdscript/warnings/native_method_override=2
gdscript/warnings/get_node_default_without_onready=2
gdscript/warnings/onready_with_export=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
; Resolution-independent UI: desktop is a target alongside phones.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[importer_defaults]

; Godot 4.7 imports glTF COLOR_0 into the mesh but leaves
; vertex_color_use_as_albedo off, so every generated tile arrives white. The
; post-import script turns it on. Set as an importer default rather than per
; file because generated assets are gitignored — their .import files do not
; survive a fresh clone.
scene={
"import_script/path": "res://tools/generated_scene_import.gd"
}

