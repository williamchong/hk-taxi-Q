[gd_resource type="Resource" script_class="HudStyle" format=3]

[ext_resource type="Script" path="res://scripts/ui/hud_style.gd" id="1_hud_style"]

; White is the city speaking, dark is the car speaking. See hud_style.gd.
;
; ⚠️ The plate white is NOT the road's paint constant.
; roadmarks.tres records the marking white as its fifth authored copy and
; boxjunctions.tres the yellow as its third; a sixth and a fourth here would be
; that debt again, and a street name plate is not paint (Q53, Q79).
;
; ⚠️ SIZES ARE ROUGHLY HALF WHAT THIS FILE FIRST SHIPPED. The first pass drew a
; 104 px numeral and a 36/42 plate, which put the speed at ~15% of frame width
; against Midtown Madness 2's ~7% and the plate at 31% against its minimap's 18%
; — the references this layout is taken from are all far quieter than the first
; attempt at following them. A HUD is furniture; the city is the deliverable.

[resource]
script = ExtResource("1_hud_style")
chamfer_px = 10.0
edge_px = 2.0
slot_edge_px = 2.0
plate_field = Color(0.93, 0.93, 0.9, 1)
plate_ink = Color(0.07, 0.07, 0.08, 1)
plate_edge = Color(0.07, 0.07, 0.08, 1)
plate_size_en = 26
plate_size_zh = 30
plate_pad = Vector2(34, 14)
chip_field = Color(0.14, 0.135, 0.128, 0.88)
chip_ink = Color(0.96, 0.96, 0.94, 1)
chip_muted = Color(0.7, 0.69, 0.65, 1)
accent = Color(0.3, 0.82, 0.38, 1)
accent_negative = Color(0.92, 0.29, 0.26, 1)
accent_track = Color(1, 1, 1, 0.12)
accent_px = 4.0
accel_full_scale_mps2 = 5.0
accel_smoothing_s = 0.18
speed_size = 68
speed_unit_size = 20
speed_line_tighten = -10
slot_fill = Color(0.3, 0.85, 0.95, 0.1)
slot_edge = Color(0.3, 0.85, 0.95, 0.55)
