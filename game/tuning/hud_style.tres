plate_edge = Color(0.07, 0.07, 0.08, 1)
plate_size_en = 36
plate_size_zh = 42
chip_field = Color(0.14, 0.135, 0.128, 0.88)
chip_ink = Color(0.96, 0.96, 0.94, 1)
chip_muted = Color(0.7, 0.69, 0.65, 1)
accent = Color(0.86, 0.68, 0.13, 1)
accent_px = 5.0
speed_size = 104
speed_unit_size = 30
speed_line_tighten = -18
slot_fill = Color(0.3, 0.85, 0.95, 0.1)
slot_edge = Color(0.3, 0.85, 0.95, 0.55)
